# ---- barrier -----------------------------------------------------------
# MPI_Barrier: a pure latency test, so no data (m=0) and no extra barrier
# around the timed calls (self_sync).

subcode: _autoload
    $global const struct coll coll_barrier = { .name = "barrier", .layout = LAYOUT_COMM, .elem = 1, .time_div = 1, .self_sync = 1, .no_data = 1, .call = call_barrier }
    $list call_barrier

subcode:: coll_cases
    $case !strcmp(name, coll_barrier.name)
        return &coll_barrier

fncode: call_barrier(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Barrier(c)
