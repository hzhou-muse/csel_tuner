# ---- iexscan -----------------------------------------------------------
# MPI_Iexscan (MPI_SUM) of m/sizeof(int) MPI_INTs, waited on at once.

subcode: _autoload
    $global const struct coll coll_iexscan = { .name = "iexscan", .layout = LAYOUT_COMM, .elem = sizeof(int), .time_div = 1, .inplace_ok = 1, .call = call_iexscan }
    $list call_iexscan

subcode:: coll_list
    coll_add(&coll_iexscan)

fncode: call_iexscan(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Iexscan(inplace_send(rq, s), r, count, MPI_INT, MPI_SUM, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
