# ---- ireduce_scatter_block ---------------------------------------------
# MPI_Ireduce_scatter_block (MPI_SUM) of MPI_INTs, waited on at once: p blocks of m bytes sent, one received.

subcode: _autoload
    $global const struct coll coll_ireduce_scatter_block = { .name = "ireduce_scatter_block", .layout = LAYOUT_COMM, .elem = sizeof(int), .sbuf_p = 1, .time_div = 1, .inplace_ok = 1, .call = call_ireduce_scatter_block }
    $list call_ireduce_scatter_block

subcode:: coll_list
    coll_add(&coll_ireduce_scatter_block)

fncode: call_ireduce_scatter_block(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Ireduce_scatter_block(inplace_send(rq, s), r, count, MPI_INT, MPI_SUM, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
