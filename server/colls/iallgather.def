# ---- iallgather --------------------------------------------------------
# MPI_Iallgather of m bytes per member, waited on at once.

subcode: _autoload
    $global const struct coll coll_iallgather = { .name = "iallgather", .layout = LAYOUT_COMM, .elem = 1, .rbuf_p = 1, .time_div = 1, .inplace_ok = 1, .check = check_copy_to_all, .call = call_iallgather }
    $list call_iallgather

subcode:: coll_list
    coll_add(&coll_iallgather)

fncode: call_iallgather(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Iallgather(inplace_send(rq, s), count, MPI_BYTE, r, count, MPI_BYTE, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
