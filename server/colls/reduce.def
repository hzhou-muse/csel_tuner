# ---- reduce ------------------------------------------------------------
# MPI_Reduce (MPI_SUM) of m/sizeof(int) MPI_INTs to root.

subcode: _autoload
    $global const struct coll coll_reduce = { .name = "reduce", .layout = LAYOUT_COMM, .elem = sizeof(int), .time_div = 1, .rooted = 1, .inplace_ok = 1, .call = call_reduce, .check = NULL }
    $list call_reduce

subcode:: coll_list
    coll_add(&coll_reduce)

fncode: call_reduce(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Reduce(inplace_root_send(rq, crank, s), r, count, MPI_INT, MPI_SUM, rq->root, c)
