# ---- igatherv ----------------------------------------------------------
# MPI_Igatherv of the counts= blocks (bytes, mean m) to root, waited on at once.

subcode: _autoload
    $global const struct coll coll_igatherv = { .name = "igatherv", .layout = LAYOUT_COMM, .elem = 1, .rooted = 1, .rbuf_p = 1, .vcounts = 1, .time_div = 1, .call = call_igatherv }
    $list call_igatherv

subcode:: coll_cases
    $case !strcmp(name, coll_igatherv.name)
        return &coll_igatherv

fncode: call_igatherv(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Igatherv(s, vc_counts[crank], MPI_BYTE, r, vc_counts, vc_displs, MPI_BYTE, rq->root, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
