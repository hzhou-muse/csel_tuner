# ---- bcast -------------------------------------------------------------
# MPI_Bcast of m bytes from root, on one buffer; check=1 broadcasts a
# pattern once and verifies it on every rank.

subcode: _autoload
    $global const struct coll coll_bcast = { .name = "bcast", .layout = LAYOUT_COMM, .elem = 1, .time_div = 1, .rooted = 1, .call = call_bcast, .check = check_bcast }
    $list call_bcast, check_bcast

subcode:: coll_list
    coll_add(&coll_bcast)

fncode: call_bcast(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Bcast(s, count, MPI_BYTE, rq->root, c)

# Broadcast a pattern once and count wrong bytes over all ranks (bcast and
# ibcast).
fncode: check_bcast(const struct req *rq, MPI_Comm c, int crank): int
    $my long n = rq->m
    $my unsigned char *b = (unsigned char *) sbuf
    $for long i = 0; i < n; i++
        b[i] = crank == rq->root ? (unsigned char) (i * 131 + rq->seq + 7) : 0
    # through the collective's own call (bcast, ibcast), on sbuf
    $my int rc
    rc = coll_find(rq->coll)->call(rq, c, crank, sbuf, rbuf, n)
    $if rc != MPI_SUCCESS && !call_err
        call_err = rc
    $my int bad = 0
    $for long i = 0; i < n; i++
        $if b[i] != (unsigned char) (i * 131 + rq->seq + 7)
            bad++
    return (int) agree(c, bad, AGREE_SUM)
