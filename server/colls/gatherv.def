# ---- gatherv -----------------------------------------------------------
# MPI_Gatherv of the counts= blocks (bytes, mean m) to root.

subcode: _autoload
    $global const struct coll coll_gatherv = { .name = "gatherv", .layout = LAYOUT_COMM, .elem = 1, .rooted = 1, .rbuf_p = 1, .vcounts = 1, .time_div = 1, .call = call_gatherv }
    $list call_gatherv

subcode:: coll_list
    coll_add(&coll_gatherv)

fncode: call_gatherv(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Gatherv(s, vc_counts[crank], MPI_BYTE, r, vc_counts, vc_displs, MPI_BYTE, rq->root, c)
