# ---- iscatter ----------------------------------------------------------
# MPI_Iscatter of m bytes per member from root, waited on at once.

subcode: _autoload
    $global const struct coll coll_iscatter = { .name = "iscatter", .layout = LAYOUT_COMM, .elem = 1, .rooted = 1, .sbuf_p = 1, .time_div = 1, .inplace_ok = 1, .call = call_iscatter }
    $list call_iscatter

subcode:: coll_list
    coll_add(&coll_iscatter)

fncode: call_iscatter(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Iscatter(s, count, MPI_BYTE, inplace_root_recv(rq, crank, r), count, MPI_BYTE, rq->root, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
