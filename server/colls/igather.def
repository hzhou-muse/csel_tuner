# ---- igather -----------------------------------------------------------
# MPI_Igather of m bytes per member to root, waited on at once.

subcode: _autoload
    $global const struct coll coll_igather = { .name = "igather", .layout = LAYOUT_COMM, .elem = 1, .rooted = 1, .rbuf_p = 1, .time_div = 1, .call = call_igather }
    $list call_igather

subcode:: coll_list
    coll_add(&coll_igather)

fncode: call_igather(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Igather(s, count, MPI_BYTE, r, count, MPI_BYTE, rq->root, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
