# ---- pingpong ----------------------------------------------------------
# MPI_Send/MPI_Recv of m bytes between the two ranks of pair=a,b; reports
# half the round trip.

subcode: _autoload
    $global const struct coll coll_pingpong = { .name = "pingpong", .layout = LAYOUT_PAIR, .elem = 1, .time_div = 2, .rooted = 0, .call = call_pingpong, .check = NULL }
    $list call_pingpong

subcode:: coll_list
    coll_add(&coll_pingpong)

# one buffer, like bench/pingpong.c
fncode: call_pingpong(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my int rc
    $if crank == 0
        rc = MPI_Send(s, count, MPI_BYTE, 1, 0, c)
        $if rc == MPI_SUCCESS
            rc = MPI_Recv(s, count, MPI_BYTE, 1, 0, c, MPI_STATUS_IGNORE)
    $else
        rc = MPI_Recv(s, count, MPI_BYTE, 0, 0, c, MPI_STATUS_IGNORE)
        $if rc == MPI_SUCCESS
            rc = MPI_Send(s, count, MPI_BYTE, 0, 0, c)
    return rc
