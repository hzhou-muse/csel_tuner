# ---- reduce_scatter ----------------------------------------------------
# MPI_Reduce_scatter (MPI_SUM) of MPI_INTs: member i receives its reduced counts= block (mean m bytes).

subcode: _autoload
    $global const struct coll coll_reduce_scatter = { .name = "reduce_scatter", .layout = LAYOUT_COMM, .elem = sizeof(int), .sbuf_p = 1, .vcounts = 1, .time_div = 1, .call = call_reduce_scatter }
    $list call_reduce_scatter

subcode:: coll_cases
    $case !strcmp(name, coll_reduce_scatter.name)
        return &coll_reduce_scatter

fncode: call_reduce_scatter(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Reduce_scatter(s, r, vc_counts, MPI_INT, MPI_SUM, c)
