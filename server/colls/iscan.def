# ---- iscan -------------------------------------------------------------
# MPI_Iscan (MPI_SUM) of m/sizeof(int) MPI_INTs, waited on at once.

subcode: _autoload
    $global const struct coll coll_iscan = { .name = "iscan", .layout = LAYOUT_COMM, .elem = sizeof(int), .time_div = 1, .inplace_ok = 1, .call = call_iscan }
    $list call_iscan

subcode:: coll_list
    coll_add(&coll_iscan)

fncode: call_iscan(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Iscan(inplace_send(rq, s), r, count, MPI_INT, MPI_SUM, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
