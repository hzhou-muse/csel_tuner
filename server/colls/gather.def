# ---- gather ------------------------------------------------------------
# MPI_Gather of m bytes per member to root (p blocks there).

subcode: _autoload
    $global const struct coll coll_gather = { .name = "gather", .layout = LAYOUT_COMM, .elem = 1, .time_div = 1, .rooted = 1, .rbuf_p = 1, .inplace_ok = 1, .call = call_gather }
    $list call_gather

subcode:: coll_list
    coll_add(&coll_gather)

fncode: call_gather(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Gather(inplace_root_send(rq, crank, s), count, MPI_BYTE, r, count, MPI_BYTE, rq->root, c)
