# ---- ialltoallv --------------------------------------------------------
# MPI_Ialltoallv of the counts= blocks (bytes, mean m), members i and j exchange block (i + j) mod p, waited on at once.

subcode: _autoload
    $global const struct coll coll_ialltoallv = { .name = "ialltoallv", .layout = LAYOUT_COMM, .elem = 1, .sbuf_p = 1, .rbuf_p = 1, .vcounts = 1, .time_div = 1, .inplace_ok = 1, .check = check_exchange, .call = call_ialltoallv }
    $list call_ialltoallv

subcode:: coll_list
    coll_add(&coll_ialltoallv)

fncode: call_ialltoallv(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Ialltoallv(inplace_send(rq, s), vc_scounts, vc_sdispls, MPI_BYTE, r, vc_rcounts, vc_rdispls, MPI_BYTE, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
