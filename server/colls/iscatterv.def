# ---- iscatterv ---------------------------------------------------------
# MPI_Iscatterv of the counts= blocks (bytes, mean m) from root, waited on at once.

subcode: _autoload
    $global const struct coll coll_iscatterv = { .name = "iscatterv", .layout = LAYOUT_COMM, .elem = 1, .rooted = 1, .sbuf_p = 1, .vcounts = 1, .time_div = 1, .inplace_ok = 1, .call = call_iscatterv }
    $list call_iscatterv

subcode:: coll_list
    coll_add(&coll_iscatterv)

fncode: call_iscatterv(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my MPI_Request req
    $my int rc
    rc = MPI_Iscatterv(s, vc_counts, vc_displs, MPI_BYTE, inplace_root_recv(rq, crank, r), vc_counts[crank], MPI_BYTE, rq->root, c, &req)
    $if rc == MPI_SUCCESS
        rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    return rc
