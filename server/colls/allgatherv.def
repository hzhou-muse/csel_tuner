# ---- allgatherv --------------------------------------------------------
# MPI_Allgatherv of the counts= blocks (bytes, mean m): member i sends block i, every member receives all.

subcode: _autoload
    $global const struct coll coll_allgatherv = { .name = "allgatherv", .layout = LAYOUT_COMM, .elem = 1, .rbuf_p = 1, .vcounts = 1, .time_div = 1, .inplace_ok = 1, .call = call_allgatherv }
    $list call_allgatherv

subcode:: coll_list
    coll_add(&coll_allgatherv)

fncode: call_allgatherv(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Allgatherv(inplace_send(rq, s), vc_counts[crank], MPI_BYTE, r, vc_counts, vc_displs, MPI_BYTE, c)
