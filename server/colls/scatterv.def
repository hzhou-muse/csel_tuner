# ---- scatterv ----------------------------------------------------------
# MPI_Scatterv of the counts= blocks (bytes, mean m) from root.

subcode: _autoload
    $global const struct coll coll_scatterv = { .name = "scatterv", .layout = LAYOUT_COMM, .elem = 1, .rooted = 1, .sbuf_p = 1, .vcounts = 1, .time_div = 1, .call = call_scatterv }
    $list call_scatterv

subcode:: coll_cases
    $case !strcmp(name, coll_scatterv.name)
        return &coll_scatterv

fncode: call_scatterv(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    return MPI_Scatterv(s, vc_counts, vc_displs, MPI_BYTE, r, vc_counts[crank], MPI_BYTE, rq->root, c)
