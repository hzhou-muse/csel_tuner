# ---- idle --------------------------------------------------------------
# How ranks wait between requests (MPISRV_IDLE, MPISRV_IDLE_NS): without
# MPI calls, spinning or sleeping.

subcode: _autoload
    $include time, poll, unistd
    $global long idle_ns = 50000
    $enum(idle) IDLE_SPIN, IDLE_SLEEP, IDLE_BUSY, IDLE_SPLIT
    $global int idle_mode = IDLE_SPIN
    $global int hot                       # split: member of the last request, so spinning
    $global double spinup_us = 0

# Pause between checks without MPI calls: spin keeps the core at speed,
# sleep lets it idle.
fncode: idle_pause
    $if idle_mode == IDLE_SLEEP || (idle_mode == IDLE_SPLIT && !hot)
        $my struct timespec ts
        ts.tv_sec = idle_ns / 1000000000
        ts.tv_nsec = idle_ns % 1000000000
        nanosleep(&ts, NULL)
    $else
        $my double t0 = MPI_Wtime()
        $while (MPI_Wtime() - t0) * 1e9 < idle_ns
            $for i=0:100
                __builtin_ia32_pause()

# Wait for the next request without driving MPI progress in between. The
# request goes from world rank 0 to every rank on a binomial tree of
# point-to-point messages (as helper_bcast), never through an MPI collective:
# a collective here would run the algorithm the selection under test picks
# (MPIR_CVAR_COLL_SELECTION_JSON_FILE), and its leftover work would land in
# the next timed call. busy: a blocking receive (MPICH busy-polls its
# progress engine); otherwise a receive tested between idle pauses.
fncode: bcast_request(struct req *rq)
    $my int me = world_rank, int mask = 1
    $if me > 0
        # the parent: rank me - 2^k, k the highest bit of me
        $while mask * 2 <= me
            mask *= 2
        $if idle_mode == IDLE_BUSY
            helper_ok(MPI_Recv(rq, sizeof(*rq), MPI_BYTE, me - mask, REQUEST_TAG, MPI_COMM_WORLD, MPI_STATUS_IGNORE), "the request broadcast's MPI_Recv")
        $else
            $my MPI_Request r
            $my int done = 0
            helper_ok(MPI_Irecv(rq, sizeof(*rq), MPI_BYTE, me - mask, REQUEST_TAG, MPI_COMM_WORLD, &r), "the request broadcast's MPI_Irecv")
            $while 1
                MPI_Test(&r, &done, MPI_STATUS_IGNORE)
                $if done
                    break
                idle_pause()
        mask *= 2
    # forward: in round mask, the ranks below mask send to me + mask
    $while mask < world_size
        $if me + mask < world_size
            helper_ok(MPI_Send(rq, sizeof(*rq), MPI_BYTE, me + mask, REQUEST_TAG, MPI_COMM_WORLD), "the request broadcast's MPI_Send")
        mask *= 2

# Rank 0: read the next line; from stdin, wait for input in the idle mode.
# stdin is unbuffered (see main), so poll() sees every line not yet read even
# when a driver sends several requests at once.
fncode: read_line(char *line, int len): char *
    $if in == stdin && idle_mode != IDLE_SLEEP
        $my struct pollfd pfd
        pfd.fd = STDIN_FILENO
        pfd.events = POLLIN
        pfd.revents = 0
        $while poll(&pfd, 1, 0) == 0
            idle_pause()
    return fgets(line, len, in)
