# ---- collectives -------------------------------------------------------
# The measured call of each op, on buffers s and r of count elements (bytes
# for pingpong and bcast, MPI_INTs for the reductions). Returns the MPI error
# code. Ping-pong and bcast use s only.

fncode: call_op(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count): int
    $my int rc
    $if rq->op == OP_PINGPONG
        $if crank == 0
            rc = MPI_Send(s, count, MPI_BYTE, 1, 0, c)
            $if rc == MPI_SUCCESS
                rc = MPI_Recv(s, count, MPI_BYTE, 1, 0, c, MPI_STATUS_IGNORE)
        $else
            rc = MPI_Recv(s, count, MPI_BYTE, 0, 0, c, MPI_STATUS_IGNORE)
            $if rc == MPI_SUCCESS
                rc = MPI_Send(s, count, MPI_BYTE, 0, 0, c)
    $elif rq->op == OP_BCAST
        rc = MPI_Bcast(s, count, MPI_BYTE, rq->root, c)
    $elif rq->op == OP_REDUCE
        rc = MPI_Reduce(s, r, count, MPI_INT, MPI_SUM, rq->root, c)
    $elif rq->op == OP_IREDUCE || rq->op == OP_IALLREDUCE
        $my MPI_Request req
        $if rq->op == OP_IREDUCE
            rc = MPI_Ireduce(s, r, count, MPI_INT, MPI_SUM, rq->root, c, &req)
        $else
            rc = MPI_Iallreduce(s, r, count, MPI_INT, MPI_SUM, c, &req)
        $if rc == MPI_SUCCESS
            rc = MPI_Wait(&req, MPI_STATUS_IGNORE)
    $else
        rc = MPI_Allreduce(s, r, count, MPI_INT, MPI_SUM, c)
    return rc
