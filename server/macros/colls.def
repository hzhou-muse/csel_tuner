# ---- collectives -------------------------------------------------------
# What the shared code needs to know about a measured operation. Each
# operation is one file in colls/, included below, that defines its struct
# coll and adds itself to coll_find(); requests name it (op=NAME), and
# nothing outside its file refers to a particular operation.

include: colls/pingpong.def
include: colls/bcast.def
include: colls/allreduce.def
include: colls/reduce.def
include: colls/ireduce.def
include: colls/iallreduce.def
include: colls/barrier.def
include: colls/reduce_scatter_block.def
include: colls/allgather.def
include: colls/alltoall.def
include: colls/gather.def
include: colls/scatter.def

subcode: _autoload
    $include string
    $define(COLL_NAME_LEN) 32
    # layout: LAYOUT_PAIR (two ranks, pair=a,b) or LAYOUT_COMM (p ranks);
    # elem: bytes per element (m is in bytes, a multiple of elem);
    # time_div: the reported time per call is the call time / time_div
    # (2: ping-pong reports half the round trip); rooted: takes root=;
    # self_sync: the call synchronizes the members itself (barrier), so the
    # measurement adds no barrier before the batches or before each call;
    # no_data: no buffers, m must be 0; sbuf_p, rbuf_p: the send (receive)
    # buffer holds p blocks of m bytes, one per member, instead of one (m is
    # msg_size: the per-peer block for allgather, alltoall, gather, scatter
    # and reduce_scatter_block). Fields left out of a collective's
    # initializer are 0.
    $struct(coll) const char *name, int layout, long elem, double time_div, int rooted, int self_sync, int no_data
    $struct(coll) int sbuf_p, int rbuf_p
    # call: one call on buffers s and r of count elements, returns the MPI
    # error code; check: verify the result once and return the number of
    # wrong elements over all ranks (NULL: check=1 is ignored)
    $struct(coll) int (*call)(const struct req *rq, MPI_Comm c, int crank, char *s, char *r, long count)
    $struct(coll) int (*check)(const struct req *rq, MPI_Comm c, int crank)

# The operation called name, or NULL.
fncode: coll_find(const char *name): const struct coll *
    $call @coll_cases
    return NULL

# The larger of the send and receive buffers of a request in bytes (m
# rounded down to whole elements); each must fit the server's buffers
# (max_m bytes).
fncode: coll_buf_bytes(const struct coll *cl, const struct req *rq): long
    $my long block = rq->m / cl->elem * cl->elem
    $if cl->sbuf_p || cl->rbuf_p
        return block * rq->p
    return block
