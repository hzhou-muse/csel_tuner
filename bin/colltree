#!/usr/bin/env python3
"""Turn model files (collmodel/4, from bin/collmodel) into an MPICH
collective-selection JSON (builder v3, csel_tuner/tree.py).

    bin/colltree bcast.json [bcast_gpu.json] --out bcast_tuning.json [--tol 0.005] [--node-aware]

Then run with MPIR_CVAR_COLL_SELECTION_JSON_FILE=bcast_tuning.json (and the
collective's algorithm CVAR left at auto). Older model files convert with
bin/collmodel --import.

Each algorithm's model is fitted across layouts from all its curves; a
tree is fitted on the predictions at every point of its layouts x the size
grid, and pruned to the smallest tree whose predicted geomean regret is
within --tol of the full tree's. Without --node-aware it uses comm_size,
avg_msg_size and pof2; --node-aware adds num_nodes and ppn, conditions
MPICH has since pmodels/mpich#8048.

One subtree per restriction set (docs/design.md, sections 11 and 12), in
order of increasing mask, so every subset's subtree exists before its
supersets':
- "name=<op>-intra-0", the unrestricted algorithms, on every layout (the
  run-time fallback);
- "name=<op>-intra-<S in hex>", on the layouts where exactly the conditions
  S hold. Its candidates are every algorithm allowed in S as a leaf, and
  "call=" each built subtree of a proper subset of S that uses at least
  --min-fallback-algs algorithms (a smaller one is not worth the call: its
  algorithms are candidates directly). A call is scored at S's own layouts:
  at each point, the predicted time of what that subtree chooses there;
- "name=<op>-intra-auto", the dispatch: "dispatch=<op>-intra(<bits>)", the
  restriction-mask node of pmodels/mpich#8048 (MPICH continues in the subtree
  of the restrictions that hold, or of its largest subset that has one, at
  worst set 0); with --nested-dispatch, for an MPICH without it, nested
  restrictive conditions ending in "call=" those subtrees.

Several models, one per memory kind of the buffers (a model's "mem": host,
or device from bin/collmodel --mem device), go into one file with
subtrees of their own: the host model's as above, the device model's as
"name=<op>-intra-gpu-<S in hex>" with its own dispatch,
"dispatch=<op>-intra-gpu(<bits>)", whose fallback is
"<op>-intra-gpu-0", never a host subtree. In the device model the gpu
restriction always holds, so it is left out of S and of the algorithms'
restrictions (an algorithm restricted to gpu alone, e.g. buffer_swap, is
unrestricted there). "name=<op>-intra-auto" then starts with the gpu
condition: {"gpu": <device dispatch>, "any": <host dispatch>}. A host model
is required; each memory kind at most once.

A compositional algorithm (e.g. smp) was measured with a tuning file
selecting its inner calls. Where the output chooses it, colltree compares
the output's choices for those inner calls (on the node communicator and
the node leaders' communicator, same op) with that file's, and lists where
they differ by more than --stale-tol in predicted time: there the
measurements are stale, and the algorithm should be
measured again with the output loaded (bin/collmodel --model ... --algs smp
--inner-selection <output>).
"""
import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(HERE))

import numpy as np  # noqa: E402

from csel_tuner.model import Model  # noqa: E402
from csel_tuner.restrict import GPU, role_layout, set_name, set_prefix  # noqa: E402
from csel_tuner.single import is_pof2  # noqa: E402
from csel_tuner.tree import fit_tree, json_choice, json_tree, prune_to, select  # noqa: E402

# extra parameters of algorithm leaves (coll_algorithms.txt extra_params), at
# the CVAR defaults the measurements ran with; --param alg.key=value overrides
PARAMS = {"bcast": {"tree": {"tree_type": "kary", "k": 2, "is_non_blocking": True},
                    "pipelined_tree": {"tree_type": "kary", "k": 2, "is_non_blocking": True,
                                       "chunk_size": 8192, "recv_pre_posted": False}},
          "allreduce": {"tree": {"tree_type": "knomial_1", "k": 2, "chunk_size": 0, "buffer_per_child": False},
                        "recursive_multiplying": {"k": 2},
                        "recexch": {"k": 2, "single_phase_recv": False},
                        "k_reduce_scatter_allgather": {"k": 2, "single_phase_recv": False},
                        "ccl": {"ccl": "auto"}}}


def json_depth(o):
    return 1 + max((json_depth(v) for v in o.values() if isinstance(v, dict)), default=0)


def parse_value(v):
    if v in ("true", "false"):
        return v == "true"
    try:
        return int(v)
    except ValueError:
        return v


def points(layouts, sizes):
    """Feature arrays over every layout x size, in layout-major order."""
    X = {k: [] for k in ("N", "ppn", "p", "m", "pof2")}
    for n, q in layouts:
        for m in sizes:
            for k, v in (("N", n), ("ppn", q), ("p", n * q), ("m", m), ("pof2", float(is_pof2(n * q)))):
                X[k].append(v)
    return {k: np.array(v, float) for k, v in X.items()}


def fit(X, L, feats, a):
    t = fit_tree(X, L, feats, max_leaves=a.max_leaves)
    return prune_to(t, a.tol, a.max_regret)


def dispatch(op, bits, present, mem="host"):
    """The <op>-intra-auto subtree (of a model of `mem` buffers): nested
    conditions over the bits that some present set uses, ending in call= the
    set of the conditions that hold, or its largest present subset
    (restrictions are positive, so whatever a subset allows is allowed there
    too; at worst set 0)."""
    used = [k for k in range(len(bits)) if any(s >> k & 1 for s in present)]

    def target(s):
        best = max((x for x in present if x & ~s == 0), key=lambda x: (bin(x).count("1"), -x))
        return "call=" + set_name(op, best, mem)

    def node(i, s):
        if i == len(used):
            return target(s)
        on, off = node(i + 1, s | 1 << used[i]), node(i + 1, s)
        return off if on == off else {bits[used[i]]: on, "any": off}
    return node(0, 0)


class Sets:
    """The subtrees of one model, built in order of increasing mask."""

    def __init__(self, model, a, feats):
        self.m, self.a, self.feats = model, a, feats
        self.sizes = np.array(model.sizes)
        self.pred = {}              # (alg, layout) -> log2 T on the grid
        self.trees = {}             # mask -> (tree, [options]); an option is an algorithm or ("call", mask)
        self.lines = []

    def p(self, alg, lay):
        if (alg, lay) not in self.pred:
            self.pred[(alg, lay)] = self.m.predict(alg, *lay)
        return self.pred[(alg, lay)]

    def effective(self, mask):
        """The subtree MPICH's dispatch uses for a layout of this mask: its largest built subset."""
        return max((s for s in self.trees if s & ~mask == 0), key=lambda s: (bin(s).count("1"), -s))

    def choose(self, mask, x):
        """The algorithm subtree `mask` chooses at point x (calls followed)."""
        t, opts = self.trees[mask]
        o = opts[select(t, x)]
        return self.choose(o[1], x) if isinstance(o, tuple) else o

    def algs_used(self, mask):
        t, opts = self.trees[mask]
        out = set()
        for leaf in t.leaves():
            o = opts[leaf.alg]
            out |= self.algs_used(o[1]) if isinstance(o, tuple) else {o}
        return out

    def build(self, mask, lays):
        m = self.m
        algs = m.set_algs(mask)
        if mask == 0:
            algs = [x for x in algs if m.mask_of(x) == 0]
        if not algs:
            return False
        if mask and not any(m.mask_of(x) for x in algs):
            return False            # nothing restricted runs here: the dispatch uses a subset's subtree
        calls = [s for s in sorted(self.trees) if s != mask and s & ~mask == 0
                 and len(self.algs_used(s)) >= self.a.min_fallback_algs]
        X = points(lays, self.sizes)
        cols = [np.concatenate([self.p(x, lay) for lay in lays]) for x in algs]
        for s in calls:
            col = np.empty(len(X["p"]))
            for i in range(len(col)):
                x = {k: v[i] for k, v in X.items()}
                lay = (int(x["N"]), int(x["ppn"]))
                col[i] = self.p(self.choose(s, x), lay)[i % len(self.sizes)]
            cols.append(col)
        opts = list(algs) + [("call", s) for s in calls]
        t, path = fit(X, np.column_stack(cols), self.feats, self.a)
        self.trees[mask] = (t, opts)
        used = sorted({opts[l.alg] if not isinstance(opts[l.alg], tuple) else
                       "call=" + set_name(m.op, opts[l.alg][1], m.mem) for l in t.leaves()})
        self.lines.append(f"{set_name(m.op, mask, m.mem)}: {len(t.leaves())} leaves over {len(lays)} layouts x "
                          f"{len(self.sizes)} sizes; predicted geomean regret {path[0][1]:.4f} (full tree, "
                          f"{path[0][0]} leaves) -> {path[-1][1]:.4f}; candidates {len(opts)}; used: "
                          f"{', '.join(used)}")
        return True


def drop_bit(model, bit):
    """Leave a condition that holds everywhere in the model (gpu in a model of
    device buffers) out of its layout masks and its algorithms' restrictions."""
    model.masks = {lay: mk & ~bit for lay, mk in model.masks.items()}
    for info in model.algorithms.values():
        info["mask"] = info.get("mask", 0) & ~bit


def stale(model, S, out, x_of, tol):
    """Where the output chooses a compositional algorithm, the inner calls it
    makes (same op) that the output selects differently from the file the
    algorithm was measured under, and where the model predicts the two inner
    choices more than `tol` apart: [(alg, inner, inner layout, [sizes], new, old, ratio)]."""
    m, op = model, model.op
    trees = {k[len("name="):]: v for k, v in out.items()}
    by_leaf = {m.leaf(x): x for x in m.algorithms}
    idx = {size: i for i, size in enumerate(m.sizes)}
    found, notes = [], []
    for c in [x for x in m.algorithms if m.is_compositional(x) and x in m.curves]:
        uses = {}
        for lay in m.layouts:
            mask = S.effective(m.masks.get(lay, 0))
            for size in m.sizes:
                if S.choose(mask, x_of(lay, size)) == c:
                    uses.setdefault(lay, set()).add(size)
        if not uses:
            continue
        h = m.fit_inner.get(c)
        if not h or h not in m.inner_files:
            notes.append(f"{c}: no inner selection recorded; not checked")
            continue
        old = {k[len("name="):]: v for k, v in json.loads(m.inner_files[h]).items()}
        for inner in m.algorithms[c]["inner"]:
            sec, comm = inner.split("@", 1)
            if sec != op + "-intra":
                notes.append(f"{c}: inner {inner} is another op; not checked")
                continue
            if comm not in ("node_comm", "node_roots_comm"):
                notes.append(f"{c}: inner {inner}: not checked (only node_comm and node_roots_comm are)")
                continue
            at = {}             # inner layout -> sizes at which some outer call uses c
            for lay, sizes in uses.items():
                r = role_layout(lay, comm)
                if r[0] * r[1] > 1:
                    at.setdefault(r, set()).update(sizes)
            for r, sizes in sorted(at.items()):
                diff = {}
                for size in sorted(sizes):
                    x = x_of(r, size)
                    new = by_leaf.get(json_choice(trees[f"{op}-intra-auto"], x, trees, m.conditions))
                    was = by_leaf.get(json_choice(old[f"{op}-intra-auto"], x, old, m.conditions)) \
                        if f"{op}-intra-auto" in old else None
                    if new == was or new is None or was is None or was not in m.curves:
                        continue
                    i = idx[size]
                    ratio = 2 ** (S.p(new, r)[i] - S.p(was, r)[i])
                    if abs(np.log(ratio)) > np.log(tol):
                        diff.setdefault((new, was), []).append((size, ratio))
                for (new, was), v in diff.items():
                    rs = [q for _, q in v]
                    found.append((c, inner, r, [size for size, _ in v], new, was,
                                  float(np.exp(np.mean(np.log(rs))))))
    return found, notes


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("model", nargs="+", help="model files (collmodel/4): one of host buffers, optionally one "
                    "of device buffers")
    ap.add_argument("--out", required=True, help="selection JSON to write")
    ap.add_argument("--tol", type=float, default=0.005, help="allowed predicted geomean regret over the full tree")
    ap.add_argument("--node-aware", action="store_true", help="also split on num_nodes and ppn (MPICH with "
                    "pmodels/mpich#8048)")
    ap.add_argument("--max-regret", type=float, default=1.5,
                    help="pruning never lets a point's predicted regret rise above this")
    ap.add_argument("--max-leaves", type=int, default=1024, help="size of the full tree before pruning")
    ap.add_argument("--min-fallback-algs", type=int, default=3, help="a set may call a subset's subtree that "
                    "uses at least this many algorithms; a smaller one's algorithms are candidates directly")
    ap.add_argument("--stale-tol", type=float, default=1.05, help="report a changed inner choice of a "
                    "compositional algorithm when the model predicts the two more than this apart")
    ap.add_argument("--param", action="append", default=[], metavar="ALG.KEY=VALUE")
    ap.add_argument("--nested-dispatch", action="store_true", help="dispatch on restrictions with nested "
                    "conditions (for an MPICH without dispatch=, pmodels/mpich#8048)")
    ap.add_argument("--buffer-swap", action="store_true", help="host model only: the file measures buffer_swap "
                    "(device buffers swap to host, then the host tree): <op>-intra-auto is "
                    "{gpu: buffer_swap, any: <host dispatch>}")
    ap.add_argument("--with", dest="with_files", action="append", default=[], metavar="FILE",
                    help="also write the subtrees of FILE's other ops into --out (a tuning file for the inner "
                    "calls of another op, or the final file of several ops)")
    a = ap.parse_args(argv)
    models = []
    for path in a.model:
        try:
            models.append(Model.load(path))
        except ValueError as e:
            sys.exit(str(e))
    by_mem = {}
    for path, m in zip(a.model, models):
        if m.mem in by_mem:
            sys.exit(f"{path}: a second model of {m.mem} buffers ({by_mem[m.mem][0]})")
        by_mem[m.mem] = (path, m)
    if "host" not in by_mem:
        sys.exit("no model of host buffers (the run-time fallback)")
    op = models[0].op
    for path, m in zip(a.model, models):
        if m.op != op:
            sys.exit(f"{path}: a model of {m.op}, not {op}")
    if "device" in by_mem:
        path, m = by_mem["device"]
        if GPU not in m.conditions:
            sys.exit(f"{path}: a model of device buffers, but its catalog has no {GPU} restriction "
                     "(MPICH cannot tell device buffers apart)")
        drop_bit(m, 1 << m.conditions.index(GPU))
    feats = ["N", "ppn", "p", "m", "pof2"] if a.node_aware else ["p", "m", "pof2"]
    params = {k: dict(v) for k, v in PARAMS.get(op, {}).items()}
    for kv in a.param:
        k, v = kv.split("=", 1)
        alg, key = k.split(".", 1)
        params.setdefault(alg, {})[key] = parse_value(v)

    out, disp, built = {}, {}, []
    for mem in ("host", "device"):
        if mem not in by_mem:
            continue
        path, m = by_mem[mem]
        S = Sets(m, a, feats)
        sets = m.sets()
        for mask in sorted(sets, key=lambda s: (bin(s).count("1"), s)):
            S.build(mask, sets[mask])
        if 0 not in S.trees:
            sys.exit(f"{path}: no unrestricted algorithm with a model")

        def sub(o, m=m):
            if isinstance(o, tuple):
                return "call=" + set_name(op, o[1], m.mem)
            return ("algorithm=" + m.leaf(o), params.get(o, {}))
        out.update({f"name={set_name(op, mask, mem)}": json_tree(t, opts, sub)
                    for mask, (t, opts) in sorted(S.trees.items())})
        present = sorted(S.trees)
        if a.nested_dispatch:
            disp[mem] = dispatch(op, m.conditions, present, mem)
        else:
            bits = 0
            for s in present:
                bits |= s
            disp[mem] = "dispatch=%s(0x%x)" % (set_prefix(op, mem), bits) if bits else \
                "call=" + set_name(op, 0, mem)
        built.append((path, m, S))
    out[f"name={op}-intra-auto"] = {GPU: disp["device"], "any": disp["host"]} if "device" in disp else \
        disp["host"]
    if a.buffer_swap:
        if "device" in disp:
            sys.exit("--buffer-swap: give the host model only")
        out[f"name={op}-intra-auto"] = {GPU: {"algorithm=MPIR_Coll_buffer_swap": {}}, "any": disp["host"]}
    written = dict(out)
    for path in a.with_files:
        with open(path) as f:
            other = json.load(f)
        for k, v in other.items():
            if not k.startswith(f"name={op}-intra-"):
                written[k] = v
    depth = json_depth(written)
    if depth > 64:
        sys.exit(f"tree nests {depth} levels; MPICH's parser allows 64 (try a larger --tol)")
    with open(a.out, "w") as f:
        json.dump(written, f, indent=2)
        f.write("\n")
    for path, m, S in built:
        for line in S.lines:
            print(line)
    print(f"{a.out}: features {','.join(feats)}; nesting {depth}")

    for path, m, S in built:
        def x_of(lay, size, m=m):
            n, q = lay
            mk = m.masks.get(lay, 0)
            cond = {b: bool(mk >> k & 1) for k, b in enumerate(m.conditions)}
            cond[GPU] = m.mem == "device"   # left out of a device model's masks (drop_bit)
            return {"p": n * q, "m": size, "N": n, "ppn": q, "pof2": float(is_pof2(n * q)), "cond": cond}
        found, notes = stale(m, S, out, x_of, a.stale_tol)
        for n in notes:
            print("staleness check: " + n)
        for c, inner, r, ss, new, was, ratio in found:
            print(f"stale: {c}'s inner {inner} at N={r[0]} ppn={r[1]}, {len(ss)} sizes ({ss[0]}..{ss[-1]}): the "
                  f"output selects {new}, {c} was measured with {was} (predicted {ratio:.2f}x)")
        if found:
            print(f"remeasure: bin/collmodel --model {path} --algs "
                  f"{','.join(sorted({c for c, *_ in found}))} --inner-selection {a.out} ...")


if __name__ == "__main__":
    main()
