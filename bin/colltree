def json_depth(o):
    return 1 + max((json_depth(v) for v in o.values() if isinstance(v, dict)), default=0)


def top_entries(text):
    """[(key, key_start, value_start, value_end)] of a JSON object's top-level entries, by a scan
    that keeps strings and nesting apart (the text is valid JSON)."""
    out, depth, i, key, kstart = [], 0, 0, None, None
    vstart = None
    while i < len(text):
        c = text[i]
        if c == '"':
            j = i + 1
            while text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            if depth == 1 and key is None:
                key, kstart = json.loads(text[i:j + 1]), i
            elif depth == 1 and vstart is None:          # a string value
                out.append((key, kstart, i, j + 1))
                key = None
            i = j + 1
            continue
        if c == ":" and depth == 1 and key is not None:
            k = i + 1
            while text[k] in " \t\r\n":
                k += 1
            if text[k] in "{[":
                vstart = k
        if c in "{[":
            depth += 1
        elif c in "}]":
            depth -= 1
            if depth == 1 and vstart is not None:
                out.append((key, kstart, vstart, i + 1))
                key, vstart = None, None
        i += 1
    return out


def format_main(v, indent):
    """A subtree value for coll_selection.json: the brace on the line after its top-level key, the
    first level of conditions 8 columns in, deeper ones 4 more with the brace on the key's line, and
    an algorithm leaf or a branch that is only a leaf on one line, parameters inline."""
    if isinstance(v, str):
        return json.dumps(v)

    def inline(k, x):
        return json.dumps(k) + ": " + json.dumps(x, separators=(", ", ": "))

    def is_leaf(x):
        return isinstance(x, dict) and len(x) == 1 and next(iter(x)).startswith("algorithm=")

    def obj(o, ind, step):
        lines = []
        for i, (k, x) in enumerate(o.items()):
            sep = "," if i < len(o) - 1 else ""
            if k.startswith("algorithm="):
                lines.append(" " * ind + inline(k, x) + sep)
            elif is_leaf(x):
                lines.append(" " * ind + json.dumps(k) + ": {" + inline(*next(iter(x.items()))) + "}" + sep)
            elif isinstance(x, str):
                lines.append(" " * ind + "%s: %s" % (json.dumps(k), json.dumps(x)) + sep)
            else:
                lines.append(" " * ind + json.dumps(k) + ": {\n" + obj(x, ind + 4, 4) + "\n" + " " * ind + "}" + sep)
        return "\n".join(lines)
    return "{\n" + obj(v, indent + 8, 4) + "\n" + " " * indent + "}"


def entry_main(key, v, indent):
    """A top-level "key": value in coll_selection.json's style (a string value on the key's line)."""
    if isinstance(v, str):
        return "%s: %s" % (json.dumps(key), json.dumps(v))
    return json.dumps(key) + ":\n" + " " * indent + format_main(v, indent)


def splice_into(text, ours, colls):
    """MPICH's selection file `text` with the subtrees of `ours` ({key: value}) in place of the
    old ones: a key both have keeps its position, an old `name=<op>-intra-...` subtree of a
    collective in `colls` that ours lacks is removed, and a new key goes after its collective's
    `name=<op>-intra-auto`; every other entry stays as it was, byte for byte."""
    old = json.loads(text)
    ents = top_entries(text)
    if [e[0] for e in ents] != list(old):
        sys.exit("--into: could not take the file's top-level entries apart")
    mine = tuple(f"name={op}-intra-" for op in colls)
    kept = []                   # (key, text of "key": value) in order
    for key, ks, vs, ve in ents:
        indent = ks - text.rfind("\n", 0, ks) - 1
        if key in ours:
            kept.append((key, entry_main(key, ours[key], indent)))
        elif key.startswith(mine) and key not in ours:
            continue
        else:
            kept.append((key, text[ks:ve]))
    have = {k for k, _ in kept}
    for key in ours:
        if key in have:
            continue
        op = key[len("name="):].split("-intra-")[0]
        auto = f"name={op}-intra-auto"
        at = max((i for i, (k, _) in enumerate(kept) if k == auto or k.startswith(f"name={op}-intra-")),
                 default=len(kept) - 1)
        kept.insert(at + 1, (key, entry_main(key, ours[key], 4)))
        have.add(key)
    first, end = ents[0][1], ents[-1][3]
    body = ",\n    ".join(t for _, t in kept)
    new = text[:first] + body + text[end:]
    want = {k: v for k, v in old.items() if not (k.startswith(mine) and k not in ours)}
    want.update(ours)
    if json.loads(new) != want:
        sys.exit("--into: the spliced file does not parse to the intended subtrees")
    return new


def parse_value(v):
    if v in ("true", "false"):
        return v == "true"
    try:
        return int(v)
    except ValueError:
        return v


def points(layouts, sizes):
    """Feature arrays over every layout x size, in layout-major order."""
    X = {k: [] for k in ("N", "ppn", "p", "m", "pof2")}
    for n, q in layouts:
        for m in sizes:
            for k, v in (("N", n), ("ppn", q), ("p", n * q), ("m", m), ("pof2", float(is_pof2(n * q)))):
                X[k].append(v)
    return {k: np.array(v, float) for k, v in X.items()}


def on_grid(v, base):
    """Each value rounded up to a power of base: a split can then only fall on such a power,
    and v <= t for t on the grid is the same test on the true value."""
    powers = np.array([float(base ** k) for k in range(64) if base ** k < 2 ** 62])
    return powers[np.searchsorted(powers, np.maximum(v, 1))]


def fit(X, L, feats, a):
    """The pruned tree and its pruning path; with --max-depth, the depth chosen by p90 (the
    smallest depth up to --max-depth whose predicted p90 regret is at most --depth-p90 and within
    --depth-slack of the deepest's), its table [(depth, geomean, p90, max, leaves)] in t.depths."""
    X = dict(X)
    if a.msg_grid:
        X["m"] = on_grid(X["m"], a.msg_grid)
    if a.comm_grid:
        X["p"] = on_grid(X["p"], a.comm_grid)
    if a.max_depth is None:
        t, path = prune_to(fit_tree(X, L, feats, max_leaves=a.max_leaves), a.tol, a.max_regret, a.leaf_cost)
        t.depths = None
        return t, path
    fits = {d: prune_to(fit_tree(X, L, feats, max_leaves=a.max_leaves, max_depth=d), a.tol, a.max_regret, a.leaf_cost)
            for d in range(1, a.max_depth + 1)}
    table = [(d, *regret_stats(t), len(t.leaves())) for d, (t, _) in fits.items()]
    deepest = table[-1][2]
    if a.leaf_cost is not None:         # the depth that is worth its leaves at the same price
        pick = min(table, key=lambda r: np.log2(r[1]) + a.leaf_cost * r[4])[0]
    else:
        pick = next((d for d, gm, p90, mx, nl in table if p90 <= a.depth_p90 and p90 <= deepest + a.depth_slack),
                    a.max_depth)
    t, path = fits[pick]
    t.depths = (pick, table)
    return t, path


def dispatch(op, bits, present, mem="host"):
    """The <op>-intra-auto subtree (of a model of `mem` buffers): nested
    conditions over the bits that some present set uses, ending in call= the
    set of the conditions that hold, or its largest present subset
    (restrictions are positive, so whatever a subset allows is allowed there
    too; at worst set 0)."""
    used = [k for k in range(len(bits)) if any(s >> k & 1 for s in present)]

    def target(s):
        best = max((x for x in present if x & ~s == 0), key=lambda x: (bin(x).count("1"), -x))
        return "call=" + set_name(op, best, mem)

    def node(i, s):
        if i == len(used):
            return target(s)
        on, off = node(i + 1, s | 1 << used[i]), node(i + 1, s)
        return off if on == off else {bits[used[i]]: on, "any": off}
    return node(0, 0)


class Sets:
    """The subtrees of one model (a variant unit), built in order of increasing mask. The variant
    units of a collective and memory kind share `trees`, so a set may call a subset's subtree
    from another variant; `base` is the variant's input conditions, true at all its layouts."""

    def __init__(self, model, a, feats, trees=None, base=0):
        self.m, self.a, self.feats, self.base = model, a, feats, base
        self.sizes = np.array(model.sizes)
        self.pred = {}              # (alg, layout) -> log2 T on the grid
        self.trees = {} if trees is None else trees     # mask -> (tree, [options]); an option is an
        self.lines = []                                 # algorithm or ("call", mask)
        self.mine = []              # the masks this model built
        self.points = {}            # mask -> the feature arrays its tree was fitted on

    def p(self, alg, lay):
        if (alg, lay) not in self.pred:
            self.pred[(alg, lay)] = self.m.predict(alg, *lay)
        return self.pred[(alg, lay)]

    def also_p(self, O):
        """Like p(), of an --also model; NaN where it has no curve."""
        def p(alg, lay):
            k = (id(O), alg, lay)
            if k not in self.pred:
                try:
                    self.pred[k] = np.asarray(O.predict(alg, *lay), float)
                except (KeyError, ValueError):
                    self.pred[k] = np.full(len(O.sizes), np.nan)
            return self.pred[k]
        return p

    def effective(self, mask):
        """The subtree MPICH's dispatch uses for a layout of this mask: its largest built subset."""
        return max((s for s in self.trees if s & ~mask == 0), key=lambda s: (bin(s).count("1"), -s))

    def choose(self, mask, x):
        """The algorithm subtree `mask` chooses at point x (calls followed)."""
        t, opts = self.trees[mask]
        o = opts[select(t, x)]
        return self.choose(o[1], x) if isinstance(o, tuple) else o

    def algs_used(self, mask):
        t, opts = self.trees[mask]
        out = set()
        for leaf in t.leaves():
            o = opts[leaf.alg]
            out |= self.algs_used(o[1]) if isinstance(o, tuple) else {o}
        return out

    def build(self, mask, lays):
        m = self.m
        algs = m.set_algs(mask)
        if is_device(m.mem) and self.a.format != "legacy":
            # a -gpu set serves gpu_coll calls, which never swap: _coll and _local sets are apart
            algs = [x for x in algs if x != SWAP]
        if mask == 0:
            algs = [x for x in algs if m.mask_of(x) == 0]
        if not algs:
            return False
        if mask and mask != self.base and not any(m.mask_of(x) & ~self.base for x in algs):
            return False            # nothing restricted runs here: the dispatch uses a subset's subtree
        # a subset's subtree (also another variant's) is scored with this model's own curves of its
        # algorithms, so it is a candidate only where this model has them all
        have = set(algs)
        calls = [s for s in sorted(self.trees) if s != mask and s & ~mask == 0
                 and len(self.algs_used(s)) >= self.a.min_fallback_algs and self.algs_used(s) <= have]
        # the points of this model, then of each --also model at the layouts of this set
        parts = [(self.sizes, lays, self.p)]
        for O in getattr(m, "also", ()):
            ol = list(O.layouts) if mask == self.base or mask == 0 else unit_sets(O, self.base).get(mask, [])
            if ol:
                parts.append((np.array(O.sizes), ol, self.also_p(O)))
        Xs = [points(ol, sz) for sz, ol, _ in parts]
        X = {k: np.concatenate([x[k] for x in Xs]) for k in Xs[0]}
        cols = [np.concatenate([p(x, lay) for sz, ol, p in parts for lay in ol]) for x in algs]
        for s in calls:
            col = []
            for (sz, ol, p), Xp in zip(parts, Xs):
                for i in range(len(Xp["p"])):
                    x = {k: v[i] for k, v in Xp.items()}
                    lay = (int(x["N"]), int(x["ppn"]))
                    col.append(p(self.choose(s, x), lay)[i % len(sz)])
            cols.append(np.array(col))
        opts = list(algs) + [("call", s) for s in calls]
        L = np.column_stack(cols)
        bad = ~np.isfinite(L)
        if bad.any():                   # no curve in one model: costs twice the slowest it has there
            top = np.nanmax(np.where(bad, np.nan, L), axis=1) + 1
            L[bad] = top[np.nonzero(bad)[0]]
        t, path = fit(X, L, self.feats, self.a)
        self.trees[mask] = (t, opts)
        self.points[mask] = X
        self.mine.append(mask)
        used = sorted({opts[l.alg] if not isinstance(opts[l.alg], tuple) else
                       "call=" + set_name(m.op, opts[l.alg][1], m.mem) for l in t.leaves()})
        gm, p90, mx = regret_stats(t)
        self.lines.append(f"{set_name(m.op, mask, m.mem)}: {len(t.leaves())} leaves, depth {cond_depth(t)}, over "
                          f"{len(lays)} layouts x {len(self.sizes)} sizes; predicted regret geomean {gm:.4f} p90 "
                          f"{p90:.3f} max {mx:.2f} (full tree {path[0][0]} leaves, geomean {path[0][1]:.4f}); "
                          f"candidates {len(opts)}; used: {', '.join(used)}")
        if t.depths:
            pick, table = t.depths
            self.lines.append("  depth by p90 (chose %d): " % pick + "; ".join(
                f"{d}: geomean {g:.4f} p90 {q:.3f} max {x:.2f} ({nl} leaves)" for d, g, q, x, nl in table))
        return True


def above(node, P):
    """The subtree a call with comm size above P reaches: a comm_size(t) split with t < P always
    takes its right branch (in place)."""
    while node.split is not None and node.split[0] == "p" and node.split[1] < P:
        node.split, node.idx, node.alg, node.cost = node.split[3].split, node.split[3].idx, \
            node.split[3].alg, node.split[3].cost
    if node.split is not None:
        above(node.split[2], P)
        above(node.split[3], P)
    return node


def guard_comm_size(a, models):
    """--guard-above's comm size: the number, or (auto) the largest measured among the models."""
    if a.guard_above != "auto":
        return int(a.guard_above)
    return max(n * q for m in models for n, q in m.measured_layouts())


def guarded(t, opts, X, cls, P, linear_above):
    """A copy of tree t for communicators above comm size P (the sampled range): the branches
    only smaller communicators reach dropped (above), then a leaf whose algorithm is in the
    linear growth class of its size band (the band of the median size of its points; the
    interval above linear_above) is replaced by the candidate with the least regret at the
    leaf's largest sampled comm size among those not linear whose exponent is below
    linear_above. A leaf of unclear class is kept and reported (anchors from a few nodes
    leave most logarithmic algorithms unclear); so are an algorithm without anchors and a leaf
    that calls another subtree. cls: growth.classes() of the model. Returns (copy, [report
    lines])."""
    from csel_tuner.growth import LAT_MAX
    g = above(copy.deepcopy(t), P)
    notes = []
    for leaf in g.leaves():
        a = opts[leaf.alg]
        if isinstance(a, tuple):
            continue
        band = "lat" if np.median(X["m"][leaf.idx]) <= LAT_MAX else "bw"
        c = cls.get(a, {}).get(band, (None,))[0]
        if c == "unclear":
            notes.append(f"{a} (unclear, {band} band): kept")
        if c != "linear":
            continue

        def below(o):
            cl, fit = cls.get(o, {}).get(band, (None, None))
            return cl is not None and cl != "linear" and fit is not None and fit[0] < linear_above
        cand = [j for j, o in enumerate(opts) if not isinstance(o, tuple) and below(o)]
        ps = X["p"][leaf.idx]
        top = leaf.idx[ps == ps.max()]
        if not cand:
            notes.append(f"{a} ({c}, {band} band): no candidate with an exponent below {linear_above}, kept")
            continue
        j = min(cand, key=lambda j: float(t.R[top, j].sum()))
        notes.append(f"{a} -> {opts[j]} ({c} in the {band} band; scored at p={int(ps.max())}, sizes "
                     f"{int(X['m'][leaf.idx].min())}..{int(X['m'][leaf.idx].max())})")
        leaf.alg = j

    def merge(node):
        """Collapse splits whose two sides now pick the same algorithm."""
        if node.split is None:
            return
        merge(node.split[2])
        merge(node.split[3])
        left, right = node.split[2], node.split[3]
        if left.split is None and right.split is None and left.alg == right.alg:
            node.split, node.alg = None, left.alg
    merge(g)
    return g, notes


def variant_base(model):
    """The mask of the unit's input conditions that hold (its tags' variant), set at all its
    layouts: the precheck finds an input condition only where an algorithm restricts on it."""
    base = 0
    for r, v in model.tags.get("variant", {}).items():
        if r in model.conditions:
            bit = 1 << model.conditions.index(r)
            base |= bit if v else 0
            model.masks = {lay: (mk | bit) if v else (mk & ~bit) for lay, mk in model.masks.items()}
    model.masks = {lay: model.masks.get(lay, 0) | base for lay in model.layouts}
    return base


def variant_report(op, mem, units, trees):
    """The variants of a collective without a unit here: those not measured by design (no recipe,
    e.g. user ops) and those missing, each with the subtree its calls reach (the dispatch's largest
    built subset of its input conditions, before any set condition)."""
    m0 = units[0]
    have = [m.tags.get("variant", {}) for m in units]
    groups = {}             # (what, target mask) -> [variant]
    for v in variants(op, m0.conditions):
        if any(all(h.get(k) == x for k, x in v.items()) for h in have):
            continue
        base = sum(1 << m0.conditions.index(k) for k, x in v.items() if x)
        to = max((s for s in trees if s & ~base == 0), key=lambda s: (bin(s).count("1"), -s))
        what = "not measured (no recipe)" if not measured(v) else "missing (not measured yet)"
        groups.setdefault((what, to), []).append(v)
    lines = []
    for (what, to), vs in groups.items():
        # the assignments the group's variants share, e.g. builtin_op=0 for the user ops
        common = {k: x for k, x in vs[0].items() if all(v.get(k) == x for v in vs)}
        name = " ".join("%s=%s" % kv for kv in sorted(common.items()))
        lines.append(f"{set_prefix(op, mem)}: {what}: {len(vs)} variant{'s' if len(vs) > 1 else ''} {name}; "
                     f"{'their' if len(vs) > 1 else 'its'} calls use {set_name(op, to, mem)}")
    return lines


def unit_sets(model, base):
    """{mask: [layouts]} of a variant unit: its base set (its input conditions) at every layout, and
    each other mask at the layouts where exactly it holds (Model.sets() for base 0)."""
    out = {base: list(model.layouts)}
    for lay in model.layouts:
        mk = model.masks.get(lay, 0)
        if mk != base:
            out.setdefault(mk, []).append(lay)
    return out


def drop_bit(model, bit):
    """Leave a condition that holds everywhere in the model (gpu in a model of
    device buffers) out of its layout masks and its algorithms' restrictions."""
    model.masks = {lay: mk & ~bit for lay, mk in model.masks.items()}
    for info in model.algorithms.values():
        info["mask"] = info.get("mask", 0) & ~bit


def x_of(m, lay, size):
    """The point of a call at layout lay and this size, in model m (its conditions at lay)."""
    n, q = lay
    mk = m.masks.get(lay, 0)
    cond = {b: bool(mk >> k & 1) for k, b in enumerate(m.conditions)}
    cond[GPU_LOCAL] = is_device(m.mem)      # left out of a device model's masks (drop_bit)
    cond["gpu"] = cond[GPU_LOCAL]           # its old name, in inner selection files of older runs
    if m.mem == "gpu":
        cond[GPU_COLL] = True
    return {"p": n * q, "m": size, "N": n, "ppn": q, "pof2": float(is_pof2(n * q)), "cond": cond}


def parse_inner(text):
    """"bcast-intra@node_comm", "bcast-intra@comm[gpu_local=0]" -> (coll, comm, {cond: value})."""
    sec, _, rest = text.partition("@")
    comm, _, cond = rest.partition("[")
    conds = dict(kv.split("=", 1) for kv in cond.rstrip("]").split(",") if kv)
    return sec.rsplit("-", 1)[0], comm, {canon_condition(k): int(v) for k, v in conds.items()}


def pick_variant(units, caller):
    """Of an inner collective's variant units [(model, Sets)], the one whose input conditions agree
    with the caller's on the conditions both have (an inner call passes its buffers and op on),
    else the first; None if there are none."""
    if not units:
        return None
    mine = caller.tags.get("variant", {})
    for m, S in units:
        v = m.tags.get("variant", {})
        if all(v[k] == mine[k] for k in v if k in mine):
            return m, S
    return units[0]


def stale(model, S, out, built, tol):
    """Where the output chooses a compositional algorithm, the inner calls it
    makes that the output selects differently from the file the algorithm was
    measured under, and where the inner collective's model predicts the two
    choices more than `tol` apart: [(alg, inner, inner layout, [sizes], new, old, ratio)].
    built: {(coll, "host"|"device"): [(model, Sets)]} of this output. An inner call with [gpu_local=0]
    has host buffers. Any other inner call of a device unit may select with or without gpu_coll,
    which the algorithm decides in its code (it may clear the condition for host temporaries, or
    keep it with device ones), so both choices are compared, each timed by the unit's model. Inner
    calls select with call=auto and the flags they inherit, so on device buffers they can reach the
    local set (legacy: from auto, so only a user's call can swap, in main)."""
    m = model
    trees = {k[len("name="):]: v for k, v in out.items()}
    slot = "device" if is_device(m.mem) else "host"
    found, notes = [], []
    for c in [x for x in m.algorithms if m.is_compositional(x) and x in m.curves]:
        uses = {}
        for lay in m.layouts:
            mask = S.effective(m.masks.get(lay, 0))
            for size in m.sizes:
                if S.choose(mask, x_of(m, lay, size)) == c:
                    uses.setdefault(lay, set()).add(size)
        if not uses:
            continue
        # a model grown over job sizes has run c under several inner selections, each at its own layouts
        by_hash = {}
        for lay in uses:
            by_hash.setdefault(m.inner_at(c, lay), []).append(lay)
        for h, lays in by_hash.items():
            if not h or h not in m.inner_files:
                notes.append(f"{c}: no inner selection recorded; not checked")
                continue
            old = {k[len("name="):]: v for k, v in json.loads(m.inner_files[h]).items()}
            for inner in m.algorithms[c]["inner"]:
                coll, comm, cond = parse_inner(inner)
                on_device = slot == "device" and cond.get(GPU_LOCAL) != 0
                target = pick_variant(built.get((coll, "host" if cond.get(GPU_LOCAL) == 0 else slot)), m)
                if target is None:
                    notes.append(f"{c}: inner {inner}: {coll}'s tree is not in this output; not checked")
                    continue
                if comm not in ("node_comm", "node_roots_comm", "comm", "self"):
                    notes.append(f"{c}: inner {inner}: unknown communicator; not checked")
                    continue
                mi, Si = target
                by_leaf = {mi.leaf(x): x for x in mi.algorithms}
                idx = {size: i for i, size in enumerate(mi.sizes)}
                at = {}             # inner layout -> sizes at which some outer call uses c
                for lay, sizes in ((x, uses[x]) for x in lays):
                    r = role_layout(lay, comm)
                    if r[0] * r[1] > 1:
                        at.setdefault(r, set()).update(sizes)
                for r, sizes in sorted(at.items()):
                    diff = {}
                    for size in sorted(sizes):
                        if size not in idx:
                            continue
                        for gpu_coll in ((True, False) if on_device else (None,)):
                            x = x_of(mi, r, size)
                            if gpu_coll is not None:
                                x["cond"][GPU_COLL] = gpu_coll and has_gpu_coll(coll)
                                x["cond"][GPU_LOCAL] = True
                            new = by_leaf.get(file_choice(trees, f"{coll}-intra", x, mi.conditions))
                            try:
                                was = by_leaf.get(file_choice(old, f"{coll}-intra", x, mi.conditions))
                            except (KeyError, ValueError):
                                was = None
                            if new == was or new is None or was is None or was not in mi.curves:
                                continue
                            i = idx[size]
                            ratio = 2 ** (Si.p(new, r)[i] - Si.p(was, r)[i])
                            if abs(np.log(ratio)) > np.log(tol):
                                v = diff.setdefault((new, was), [])
                                if not v or v[-1][0] != size:
                                    v.append((size, ratio))
                    for (new, was), v in diff.items():
                        rs = [q for _, q in v]
                        found.append((c, inner, r, [size for size, _ in v], new, was,
                                      float(np.exp(np.mean(np.log(rs))))))
    return found, notes


def same_as_subset(trees, owner_sets):
    """{mask: subset} of the restricted subtrees that choose like their fallback (the dispatch's
    largest other subset) at every point they were fitted on: a more restricted tree is only
    worth writing if it is unique. Smallest masks first, so a fallback is one that stays."""
    dropped = {}
    for mask in sorted(trees, key=lambda s: (bin(s).count("1"), s)):
        rest = [s for s in trees if s != mask and s & ~mask == 0 and s not in dropped]
        if not rest or mask not in owner_sets:
            continue
        f = max(rest, key=lambda s: (bin(s).count("1"), -s))
        S, X = owner_sets[mask], owner_sets[mask].points[mask]
        n = len(X["p"])
        if all(S.choose(mask, {k: v[i] for k, v in X.items()}) == S.choose(f, {k: v[i] for k, v in X.items()})
               for i in range(n)):
            dropped[mask] = f
    return dropped


def gpu_coll_is_unique(host, gpu_built, swap_t):
    """Whether the gpu subtrees choose differently from what a device call gets without gpu_coll,
    the host tree's algorithm or a swap, at some point of the gpu models."""
    for gm, G in gpu_built:
        hm, S = pick_variant(host, gm)
        for lay in gm.layouts:
            if lay not in hm.masks:
                return True
            for size in gm.sizes:
                x = x_of(gm, lay, size)
                local = SWAP if swap_t is not None and select(swap_t, x) == 1 else \
                    S.choose(S.effective(hm.masks[lay]), x_of(hm, lay, size))
                if G.choose(G.effective(gm.masks.get(lay, 0)), x) != local:
                    return True
    return False


def swap_tree(op, host, gpu_units, feats, a):
    """The choice of device buffers without gpu_coll, which run the host tree's algorithm directly
    or swap first: (fitted tree over [direct, buffer_swap], [report lines]), the tree None if
    nothing swaps. Fitted on the gpu models' curves. host: [(model, Sets)]."""
    X = {k: [] for k in ("N", "ppn", "p", "m", "pof2")}
    direct, swap, missing, skipped = [], [], {}, set()
    for path, gm in gpu_units:
        hm, S = pick_variant(host, gm)
        for lay in gm.layouts:
            if lay not in hm.masks:
                skipped.add(lay)
                continue
            have = gm.set_algs(gm.masks.get(lay, 0))
            if SWAP not in have:
                continue
            times, swap_t = {}, gm.predict(SWAP, *lay)
            for i, size in enumerate(gm.sizes):
                x = x_of(hm, lay, size)
                alg = S.choose(S.effective(hm.masks[lay]), x)
                if alg not in have:
                    missing.setdefault(alg, set()).add(lay)
                    continue
                if alg not in times:
                    times[alg] = gm.predict(alg, *lay)
                for k in X:
                    X[k].append(x[k])
                direct.append(times[alg][i])
                swap.append(swap_t[i])
    lines = []
    for alg, lays in sorted(missing.items()):
        lines.append(f"{op}: {alg} has no curve on device buffers: not in the swap choice "
                     f"({len(lays)} layouts); measure it with --launch gpu")
    if skipped:
        lines.append(f"{op}: {len(skipped)} layouts of the gpu model are not in the host model: no swap choice")
    if not direct:
        return None, lines
    t, _ = fit({k: np.array(v, float) for k, v in X.items()}, np.column_stack([direct, swap]), feats, a)
    n = sum(len(l.idx) for l in t.leaves() if l.alg == 1)
    lines.append(f"{op}: device buffers without gpu_coll swap at {n} of {len(direct)} points, "
                 f"{len(t.leaves())} leaves")
    return (t if n else None), lines


def local_bit(model):
    """The mask bit of gpu_local, the local restriction, in a model's conditions."""
    return 1 << model.conditions.index(GPU_LOCAL)


def tie_aliases(present):
    """MPICH refuses two restriction sets of the same size that could both match one call (it
    cannot know which combinations of restrictions happen). {union: winner} of the sets to add,
    each a call=auto to the set the legacy dispatch used there (the most restrictions, then the
    lower mask), and [report lines] where the aliases change a combination's choice."""
    sets, aliases, lines = set(present), {}, []
    U = 0
    for s in present:
        U |= s
    pos = [k for k in range(32) if U >> k & 1]
    combos = [sum(1 << pos[j] for j in range(len(pos)) if c >> j & 1) for c in range(1 << len(pos))]

    def legacy_choice(m):
        return max((s for s in present if s & ~m == 0), key=lambda s: (bin(s).count("1"), -s))
    while True:
        tie = None
        for m in combos:
            cands = [s for s in sets if s & ~m == 0]
            if not cands:
                continue
            top = max(bin(s).count("1") for s in cands)
            win = [s for s in cands if bin(s).count("1") == top]
            if len(win) > 1:
                tie = win
                break
        if tie is None:
            break
        u = 0
        for s in tie:
            u |= s
        aliases[u] = legacy_choice(u)
        sets.add(u)
    for m in combos:
        cands = [s for s in sets if s & ~m == 0]
        if not cands:
            continue
        best = max(cands, key=lambda s: bin(s).count("1"))
        if aliases.get(best, best) != legacy_choice(m):
            lines.append("alias %x changes the set of restrictions %x: %x, legacy %x"
                         % (best, m, aliases.get(best, best), legacy_choice(m)))
    return aliases, lines


def main_tree(keys):
    """name=main from the <op>-intra-main subtrees among keys, or None if there are none."""
    ops = sorted(k[len("name="):-len("-intra-main")] for k in keys
                 if k.startswith("name=") and k.endswith("-intra-main"))
    if not ops:
        return None
    return dict({f"collective={op}-intra": f"call={op}-intra-main" for op in ops}, any="call=auto")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--unit", metavar="KEY=VALUE,...", help="the units to use from the model files, by their "
                    "tags (coll, launch, datatype, counts) or variant conditions (inplace, ...), e.g. "
                    "coll=allgather,inplace=0; default: every unit of each file")
    ap.add_argument("--colls", help="the collectives to build, e.g. bcast,ibcast; default: every collective "
                    "among the selected units")
    ap.add_argument("model", nargs="+", help="model files (collmodel/5 or /4): per collective one unit of host "
                    "buffers, optionally one of device buffers")
    ap.add_argument("--out", required=True, help="selection JSON to write")
    ap.add_argument("--tol", type=float, default=0.005, help="allowed predicted geomean regret over the full tree")
    ap.add_argument("--node-aware", action="store_true", help="also split on num_nodes and ppn (MPICH with "
                    "pmodels/mpich#8048)")
    ap.add_argument("--max-regret", type=float, default=1.5,
                    help="pruning never lets a point's predicted regret rise above this")
    ap.add_argument("--max-leaves", type=int, default=1024, help="size of the full tree before pruning")
    ap.add_argument("--max-depth", type=int, help="at most this many nested condition levels per subtree; "
                    "the depth is chosen by --depth-p90 (a compact file, e.g. MPICH's default)")
    ap.add_argument("--depth-p90", type=float, default=1.10, help="with --max-depth: the smallest depth whose "
                    "predicted p90 regret is at most this ...")
    ap.add_argument("--depth-slack", type=float, default=0.02, help="... and within this of the deepest "
                    "tree's p90; otherwise --max-depth")
    ap.add_argument("--also", action="append", default=[], metavar="MODEL", help="fit jointly with this model of "
                    "another network: every tree minimizes the regret over the points of both; the positional model's "
                    "layouts decide the guard and the swap, so give the one with the most layouts first")
    ap.add_argument("--leaf-cost", type=float, help="prune by price instead of --tol: a leaf stays only if it lowers "
                    "its subtree's mean log2 regret by this much; one price across subtrees spends the leaves where "
                    "they buy the most")
    ap.add_argument("--msg-grid", type=int, metavar="B", help="size thresholds only at powers of B (readable numbers)")
    ap.add_argument("--comm-grid", type=int, metavar="B", help="comm size thresholds only at powers of B")
    ap.add_argument("--features", metavar="COND,...", help="the CSEL conditions splits may use, from comm_size, "
                    "msg_size, pof2, num_nodes, ppn (default: comm_size, msg_size, pof2; with --node-aware also "
                    "num_nodes, ppn)")
    ap.add_argument("--min-fallback-algs", type=int, default=3, help="a set may call a subset's subtree that "
                    "uses at least this many algorithms; a smaller one's algorithms are candidates directly")
    ap.add_argument("--stale-tol", type=float, default=1.05, help="report a changed inner choice of a "
                    "compositional algorithm when the model predicts the two more than this apart")
    ap.add_argument("--param", action="append", default=[], metavar="ALG.KEY=VALUE")
    ap.add_argument("--size-condition", default="msg_size", choices=["msg_size", "avg_msg_size"],
                    help="the CSEL condition of the size splits; avg_msg_size for an MPICH without msg_size")
    ap.add_argument("--format", choices=["reserved", "legacy"], default="reserved",
                    help="reserved: MPICH's reserved set names, reached by its built-in call=auto; legacy: "
                    "<op>-intra-auto dispatches, <op>-intra-main swap choices and name=main, for an MPICH "
                    "without the reserved names")
    ap.add_argument("--nested-dispatch", action="store_true", help="with --format legacy: dispatch on "
                    "restrictions with nested conditions (for an MPICH without dispatch=, pmodels/mpich#8048)")
    ap.add_argument("--buffer-swap", action="store_true", help="host model only: the file measures buffer_swap "
                    "(device buffers swap to host, then the host tree): every device call swaps "
                    "(the local set <op>-intra-<gpu_local bit> is buffer_swap; legacy: <op>-intra-main is "
                    "{gpu_local: buffer_swap, any: call=auto})")
    ap.add_argument("--guard-above", metavar="P|auto", help="above comm size P (the largest sampled; auto: each "
                    "unit's own largest measured comm size): "
                    "each subtree's linear- or unclear-growth leaves replaced by logarithmic-growth algorithms, "
                    "the classes from the models' growth anchors (csel_tuner/growth.py); a subtree it does not "
                    "change stays as it is")
    ap.add_argument("--linear-above", type=float, default=0.7, help="with --guard-above: the growth exponent "
                    "that separates linear from logarithmic (growth.py)")
    ap.add_argument("--into", metavar="FILE", help="write --out as FILE (MPICH's src/mpi/coll/coll_selection.json) "
                    "with this run's subtrees in place of its own: the built collectives' intra subtrees "
                    "replaced, new subtrees after their collective's, every other entry kept byte for byte")
    ap.add_argument("--with", dest="with_files", action="append", default=[], metavar="FILE",
                    help="also write the subtrees of FILE's collectives that this run does not build into --out "
                    "(a tuning file for inner calls into another collective, or the final file)")
    a = ap.parse_args(argv)
    restrict.NAMES = a.format
    legacy = a.format == "legacy"
    if a.nested_dispatch and not legacy:
        sys.exit("--nested-dispatch: only with --format legacy")
    try:
        sel = parse_sel(a.unit)
    except ValueError as e:
        sys.exit(f"--unit: {e}")
    want = [x for x in (a.colls or "").split(",") if x]
    units = []          # [(path, unit)]
    for path in a.model:
        try:
            f = ModelFile.load(path)
        except (OSError, ValueError) as e:
            sys.exit(str(e))
        found = [u for u in f.select(sel) if not want or u.op in want]
        if not found:
            sys.exit(f"{path}: no unit selected by --unit/--colls (its units: "
                     + "; ".join(tag_str(u.tags) for u in f.units) + ")")
        units += [(path, u) for u in found]
    # per collective and memory kind (host, or device: launch kind gpu or device), its variant units
    colls = {}
    for path, m in units:
        if is_rooted(m.op) and (m.tags.get("variant") or {}).get("inplace"):
            sys.exit(f"{path}: {tag_str(m.tags)}: an in-place unit of a rooted collective (MPI_IN_PLACE at the "
                     "root only, so a dispatch on it would differ between ranks); leave it out with --unit "
                     f"coll={m.op},inplace=0, or remeasure without it")
        if m.mem == "device":
            sys.exit(f"{path}: {tag_str(m.tags)}: launch kind device has no gpu_coll subtree to build; measure "
                     "device buffers with --launch gpu")
        slot = "device" if is_device(m.mem) else "host"
        colls.setdefault(m.op, {}).setdefault(slot, []).append((path, m))
    missing = [x for x in want if x not in colls]
    if missing:
        sys.exit(f"--colls: no unit of {', '.join(missing)}")
    bases = {}          # id(model) -> its variant's input conditions (mask)
    for op, by_mem in colls.items():
        if "host" not in by_mem:
            sys.exit(f"{op}: no unit of host buffers (the run-time fallback)")
        for path, m in by_mem.get("device", []):
            if GPU_LOCAL not in m.conditions:
                sys.exit(f"{path}: a model of device buffers, but its catalog has no {GPU_LOCAL} restriction "
                         "(MPICH cannot tell device buffers apart)")
            if GPU_COLL not in m.conditions:
                sys.exit(f"{path}: a model of device buffers, but its catalog has no {GPU_COLL} restriction")
            drop_bit(m, 1 << m.conditions.index(GPU_LOCAL))
            # gpu_coll holds in the whole unit too (MPIR_CVAR_ENABLE_GPU_COLL=1)
            drop_bit(m, 1 << m.conditions.index(GPU_COLL))
        for slot, ums in by_mem.items():
            seen = {}
            for path, m in ums:
                if m.conditions != ums[0][1].conditions:
                    sys.exit(f"{path}: {tag_str(m.tags)} has the restrictions {m.conditions}, "
                             f"{tag_str(ums[0][1].tags)} {ums[0][1].conditions} (one catalog per collective)")
                base = bases[id(m)] = variant_base(m)
                if base in seen:
                    sys.exit(f"{path}: a second {op} unit of {slot} buffers with the same input conditions "
                             f"({tag_str(m.tags)}; the first: {tag_str(seen[base][1].tags)} in {seen[base][0]}); "
                             "select one with --unit")
                seen[base] = (path, m)
    for path in a.also:
        try:
            bytag = {tag_key(u.tags): u for u in ModelFile.load(path).units}
        except (OSError, ValueError) as e:
            sys.exit(str(e))
        for by_mem in colls.values():
            for slot, ums in by_mem.items():
                for p, m in ums:
                    O = bytag.get(tag_key(m.tags))
                    if O is None:
                        print(f"{path}: no unit like {tag_str(m.tags)}; not in the joint fit", file=sys.stderr)
                        continue
                    if slot == "device":
                        drop_bit(O, 1 << O.conditions.index(GPU_LOCAL))
                        drop_bit(O, 1 << O.conditions.index(GPU_COLL))
                    variant_base(O)
                    m.also = getattr(m, "also", []) + [O]
    if a.buffer_swap and any("device" in by_mem for by_mem in colls.values()):
        sys.exit("--buffer-swap: give host models only")
    feats = ["N", "ppn", "p", "m", "pof2"] if a.node_aware else ["p", "m", "pof2"]
    if a.features:
        key = {"comm_size": "p", "msg_size": "m", "pof2": "pof2", "num_nodes": "N", "ppn": "ppn"}
        bad = [f for f in a.features.split(",") if f not in key]
        if bad:
            sys.exit(f"--features: unknown {', '.join(bad)} (comm_size, msg_size, pof2, num_nodes, ppn)")
        feats = [key[f] for f in a.features.split(",")]
    names = dict(CSEL_NAME, m=a.size_condition)
    override = {}
    for kv in a.param:
        k, v = kv.split("=", 1)
        alg, key = k.split(".", 1)
        override.setdefault(alg, {})[key] = parse_value(v)
    warned = set()

    def leaf_params(m, alg):
        rec = m.algorithms.get(alg, {}).get("params")
        if rec is None:
            rec = LEGACY_PARAMS.get(m.op, {}).get(alg, {})
            if rec and (m.op, alg) not in warned:
                print(f"{m.op} {alg}: the model has no recorded leaf parameters; using {rec}", file=sys.stderr)
                warned.add((m.op, alg))
        return dict(rec, **override.get(alg, {}))

    out, built, report = {}, {}, []     # built: {(coll, slot): [(path, model, Sets)]}
    swap_fit = {}                       # op -> its swap choice's fitted tree, or None
    growth_cls = {}                     # id(model) -> growth.classes(model)
    for op, by_mem in colls.items():
        disp = {}
        for mem in ("host", "device"):
            if mem not in by_mem:
                continue
            if mem == "device" and not has_gpu_coll(op):
                report.append(f"{op}: no gpu_coll in MPICH: no gpu subtrees; its gpu model only serves the swap choice")
                continue
            trees, jobs = {}, []        # jobs: (mask, layouts, Sets), built in order of increasing mask
            fs = feats if has_msg_size(op) else [f for f in feats if f != "m"]
            for path, m in by_mem[mem]:
                S = Sets(m, a, fs, trees, bases[id(m)])
                built.setdefault((op, mem), []).append((path, m, S))
                jobs += [(mask, lays, S) for mask, lays in unit_sets(m, S.base).items()]
            if 0 not in [mask for mask, _, _ in jobs]:
                # no variant without input conditions (the reductions measure builtin commutative ops):
                # the one with the fewest builds the run-time fallback from its unrestricted algorithms
                S = min((x[2] for x in built[(op, mem)]), key=lambda S: (bin(S.base).count("1"), S.base))
                jobs.append((0, list(S.m.layouts), S))
                print(f"{set_name(op, 0, mem)}: from {tag_str(S.m.tags)}, its unrestricted algorithms",
                      file=sys.stderr)
            for mask, lays, S in sorted(jobs, key=lambda j: (bin(j[0]).count("1"), j[0])):
                S.build(mask, lays)
            if 0 not in trees:
                sys.exit(f"{op}: no unrestricted algorithm with a model")
            report += variant_report(op, mem, [m for path, m in by_mem[mem]], trees)
            if mem == "host" and "device" in by_mem:
                host_units = [(m, S) for path, m, S in built[(op, mem)]]
                swap_t, lines = swap_tree(op, host_units, by_mem["device"] + [(p, O) for p, m in by_mem["device"]
                                                                              for O in getattr(m, "also", ())], fs, a)
                report += lines
                swap_fit[op] = swap_t
                if swap_t is not None:
                    # legacy: main's choice before call=auto; reserved: the local set, whose other leaf
                    # leaves gpu_local out, where the host ranks go
                    L = local_bit(by_mem["host"][0][1])
                    stay = "call=auto" if legacy else "call=auto(%x)" % L
                    branch = json_tree(swap_t, ["direct", "swap"], lambda o: stay if o == "direct"
                                       else ("algorithm=" + SWAP_LEAF, {}), names)
                    if a.guard_above is not None:
                        branch = {"comm_size(%d)" % guard_comm_size(a, [m for path, m in by_mem["device"]]): branch,
                                  "any": stay}
                    if legacy:
                        first = {GPU_COLL: "call=auto"} if has_gpu_coll(op) else {}
                        out[f"name={op}-intra-main"] = dict(first, **{GPU_LOCAL: branch, "any": "call=auto"})
                    else:
                        out[f"name={set_name(op, L)}"] = branch

            owner = {mask: m for path, m, S in built[(op, mem)] for mask in S.mine}
            owner_sets = {mask: S for path, m, S in built[(op, mem)] for mask in S.mine}
            dropped = same_as_subset(trees, owner_sets)
            if dropped:
                report.append(f"{set_prefix(op, mem)}: not written, same choices as a subset's subtree: "
                              + ", ".join(set_name(op, s, mem) for s in sorted(dropped)))

            def kept(s):
                while s in dropped:
                    s = dropped[s]
                return s

            present = sorted(s for s in trees if s not in dropped)
            U = 0
            for s_ in present:
                U |= s_

            def sub(o, m):
                if isinstance(o, tuple):
                    if legacy:
                        return "call=" + set_name(op, kept(o[1]), mem)
                    # leave out every restriction of the family that the subset lacks: the lookup
                    # then lands on the subset whatever else holds
                    return "call=auto(%x)" % (U & ~kept(o[1]))
                return ("algorithm=" + m.leaf(o), leaf_params(m, o))
            for mask, (t, opts) in sorted(trees.items()):
                if mask in dropped:
                    continue
                key = f"name={set_name(op, mask, mem)}"
                tree_json = json_tree(t, opts, lambda o, m=owner[mask]: sub(o, m), names)
                if a.guard_above is not None:
                    m = owner[mask]
                    if id(m) not in growth_cls:
                        growth_cls[id(m)] = growth_classes(m, a.linear_above)
                        report += growth_table(m, growth_cls[id(m)]) if growth_cls[id(m)] else \
                            [f"{tag_str(m.tags)}: no growth anchors; --guard-above leaves its subtrees as they are"]
                    P = guard_comm_size(a, [m])
                    g, notes = guarded(t, opts, owner_sets[mask].points[mask], growth_cls[id(m)], P, a.linear_above)
                    if notes:
                        report += [f"guard {set_name(op, mask, mem)} above comm_size {P}:"] + \
                            ["  " + n for n in notes]
                    g_json = json_tree(g, opts, lambda o, m=m: sub(o, m), names)
                    if g_json != tree_json:
                        tree_json = {"comm_size(%d)" % P: tree_json, "any": g_json}
                out[key] = tree_json
            if not legacy:
                aliases, lines = tie_aliases(present)
                for u, w in sorted(aliases.items()):
                    out[f"name={set_name(op, u, mem)}"] = "call=auto(%x)" % (U & ~w)
                if aliases:
                    report.append(f"{op} {mem}: tied sets resolved by aliases: " + ", ".join(
                        f"{set_name(op, u, mem)} -> {set_name(op, w, mem)}" for u, w in sorted(aliases.items())))
                report += lines
                continue
            if a.nested_dispatch:
                disp[mem] = dispatch(op, by_mem[mem][0][1].conditions, present, mem)
            else:
                bits = 0
                for s in present:
                    bits |= s
                disp[mem] = "dispatch=%s(0x%x)" % (set_prefix(op, mem), bits) if bits else \
                    "call=" + set_name(op, 0, mem)
        has_dev = (op, "device") in built and (legacy and "device" in disp or not legacy)
        # without its -gpu sets a gpu_coll call runs the host sets' choice; legacy: or the swap choice
        if has_dev and not gpu_coll_is_unique([(m, S) for path, m, S in built[(op, "host")]],
                                              [(m, S) for path, m, S in built[(op, "device")]],
                                              swap_fit.get(op) if legacy else None):
            report.append(f"{op}: gpu_coll selects the same as without it: its subtrees are not written")
            disp.pop("device", None)
            gpu_keys = [k for k in out if k.startswith(f"name={set_prefix(op, 'gpu')}-")] if legacy else \
                [k for k in out if k.startswith(f"name={op}-intra-") and k.endswith("-gpu")]
            for key in gpu_keys:
                del out[key]
            if f"name={op}-intra-main" in out:
                out[f"name={op}-intra-main"].pop(GPU_COLL, None)
        if not legacy:
            if a.buffer_swap:
                out[f"name={set_name(op, local_bit(colls[op]['host'][0][1]))}"] = {"algorithm=" + SWAP_LEAF: {}}
            continue
        out[f"name={op}-intra-auto"] = {GPU_COLL: disp["device"], "any": disp["host"]} if "device" in disp else \
            disp["host"]
        if a.buffer_swap:
            out[f"name={op}-intra-main"] = {GPU_LOCAL: {"algorithm=" + SWAP_LEAF: {}}, "any": "call=auto"}
    written = dict(out)
    mine = tuple(f"name={op}-intra-" for op in colls)
    for path in a.with_files:
        with open(path) as f:
            other = json.load(f)
        for k, v in other.items():
            if not k.startswith(mine) and k != "name=main":
                written[k] = v
    entry = main_tree(written) if legacy else None
    if entry is not None:
        written["name=main"] = entry
    depth = json_depth(written)
    if depth > 64:
        sys.exit(f"tree nests {depth} levels; MPICH's parser allows 64 (try a larger --tol)")
    if a.into:
        with open(a.into) as f:
            text = f.read()
        keep = [k for k in json.loads(text) if not k.startswith(mine)]
        if not legacy and "name=auto" in keep:
            sys.exit(f"--into {a.into}: the file routes through name=auto (the legacy format); "
                     "use --format legacy, or a coll_selection.json with the reserved set names")
        entry = main_tree(list(out) + keep) if legacy else None
        text = splice_into(text, dict(out, **{"name=main": entry}) if entry else out, colls)
        with open(a.out, "w") as f:
            f.write(text)
    else:
        with open(a.out, "w") as f:
            json.dump(written, f, indent=2)
            f.write("\n")
    every = [x for v in built.values() for x in v]
    for path, m, S in every:
        for line in S.lines:
            print(line)
    for line in report:
        print(line)
    print(f"{a.out}: {', '.join(colls)}; features {','.join(feats)}; nesting {depth}")

    models = {k: [(m, S) for path, m, S in v] for k, v in built.items()}
    for path, m, S in every:
        found, notes = stale(m, S, out, models, a.stale_tol)
        for n in notes:
            print(f"staleness check: {m.op} " + n)
        for c, inner, r, ss, new, was, ratio in found:
            print(f"stale: {m.op} {c}'s inner {inner} at N={r[0]} ppn={r[1]}, {len(ss)} sizes ({ss[0]}..{ss[-1]}): "
                  f"the output selects {new}, {c} was measured with {was} (predicted {ratio:.2f}x)")
        if found:
            print(f"remeasure: bin/collmodel --model {path} --colls {m.op} --algs "
                  f"{','.join(sorted({c for c, *_ in found}))} --inner-selection {a.out} ...")


if __name__ == "__main__":
    main()
